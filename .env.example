# ── COPY THIS TO .env AND FILL IN YOUR VALUES ──────────────────

# Database
DB_PASSWORD=your_strong_password_here

# Security
JWT_SECRET=your_jwt_secret_64_chars_minimum_random_string
ENCRYPTION_KEY=your_32_char_aes_key_here!!!!!!!!

# URLs
FRONTEND_URL=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api

# Node
NODE_ENV=production
PORT=3001

# ── Global API Keys (híbrido - override por usuario en DB) ──────
# Si no se configura por usuario, se usa esta key global
KIMI_API_KEY=your_kimi_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Local Services (Docker) ──────────────────────────────────────
# URLs de microservicios locales (Docker)
PIPER_URL=http://localhost:5000
WHISPER_URL=http://localhost:8080
